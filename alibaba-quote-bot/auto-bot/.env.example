# Copiar a ".env" (que nunca se commitea) y completar.

# Umbrales para elegir proveedor. El bot NUNCA le escribe a un proveedor
# que no sea Verified Supplier / Trade Assurance, sin importar estos numeros.
MIN_RATING=4.5
MIN_REVIEWS=20
MAX_SUPPLIERS_PER_ORDER=3

# Margen por defecto aplicado sobre el costo del proveedor + envio prorrateado.
DEFAULT_MARGIN_PERCENT=25

# Seguridad: mientras sea "true", el bot arma todo pero NO aprieta enviar
# ni en el chat del proveedor ni al parsear (solo escribe en logs/ lo que
# HARIA). Poner en "false" recien cuando ya probaste selectors y flujo.
DRY_RUN=true

# Opcional: si se completa, el bot usa la API de Claude para leer la
# respuesta del proveedor (mas confiable que la heuristica por regex).
# Nunca commitear esta clave.
ANTHROPIC_API_KEY=
